+#ifdef CONFIG_RT_MUTEXES
+#define fetch_and_set(x, v) ({ int _x = (x); (x) = (v); _x; })
+#endif
+
+void rt_mutex_pre_schedule(void)
+{
+#ifdef CONFIG_RT_MUTEXES
+	lockdep_assert(!fetch_and_set(current->sched_rt_mutex, 1));
+#endif
+	sched_submit_work(current);
